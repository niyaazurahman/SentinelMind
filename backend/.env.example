# ==============================================================================
# SentinelMind - Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT="production"
PROJECT_NAME="SentinelMind Personnel Welfare & Stress Monitoring"
API_V1_STR="/api/v1"
DEBUG=false

# Networking & CORS
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="[\"https://sentinelmind.defense.mil\",\"https://localhost:3000\"]"

# Database Configuration (PostgreSQL Async)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sentinel_admin"
POSTGRES_PASSWORD="CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD"
POSTGRES_DB="sentinelmind_db"
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_SIZE=20
POSTGRES_POOL_TIMEOUT=30

# Cryptography & JWT Authentication
# Generate keys with: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_ALGORITHM="RS256"
JWT_PRIVATE_KEY_PATH="/secrets/jwt/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="/secrets/jwt/jwt-public.pem"
JWT_SECRET_KEY="FALLBACK_DEV_SECRET_KEY_REPLACE_WITH_RSA_OR_SECURE_RANDOM"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2 Password Hashing Parameters
PASSWORD_HASH_ROUNDS=3
PASSWORD_MEMORY_COST_KIB=65536
PASSWORD_PARALLELISM=4

# Redis (Session Cache, Token Revocation & Task Queue)
REDIS_URL="redis://localhost:6379/0"
